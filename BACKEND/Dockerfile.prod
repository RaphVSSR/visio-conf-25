# Stage 1 — Build TypeScript
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY src/ ./src/
COPY tsconfig*.json ./

RUN npm run build

# Stage 2 — Production runtime
FROM node:22-alpine AS runner

ENV NODE_ENV=prod

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/controller/*.js ./dist/controller/
RUN sed -i 's/\.ts"/\.js"/g' ./dist/controller/*.js

EXPOSE 3220

CMD ["node", "dist/index.js"]
