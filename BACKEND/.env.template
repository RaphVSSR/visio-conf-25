# Configuration Backend

# Base de donnees MongoDB
MONGO_URI=mongodb://localhost:27017/visio-conf

# Configuration serveur
PORT=3220
NODE_ENV=dev
VERBOSE=false
VERBOSE_LVL=3 # 1 to 3

# URL(s) frontend autorisee(s) par CORS.
# En ligne, remplacez par le domaine HTTPS public. Plusieurs URLs possibles, separees par des virgules.
FRONTEND_URL=http://localhost:3000
API_BASE_PREFIX=/api

# Ne jamais activer en preprod/prod sauf operation volontaire de reset.
FLUSH_DB_ON_START=false

# URLs pour le stockage de fichiers
FILE_STORAGE_URL=http://localhost:3220/api/files
PROFILE_PICTURES_URL=http://localhost:3220/api/files/profile

# Chaine de caracteres au format zeit/ms (ex: "24h", "7d", "60m", "3600s")
SESSION_DURATION=24h
SESSION_SECRET=change-me-in-production

# En production cross-domain HTTPS, utiliser "none". En local, garder "lax".
SESSION_COOKIE_SAMESITE=lax

# Entier en secondes, delai d'attente pour l'approbation multi-session
SESSION_APPROVAL_TIMEOUT_SECONDS=60

# Notes:
# - Pour MongoDB local: utilisez mongodb://localhost:27017/visioconf
# - Pour MongoDB Atlas: utilisez mongodb+srv://username:password@cluster.mongodb.net/visioconf
# - En NODE_ENV=prod, les origines localhost ne sont plus autorisees automatiquement.